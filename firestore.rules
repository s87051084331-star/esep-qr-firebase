rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validPayload() {
      return request.resource.data.keys().hasOnly(['payload','updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 700000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/meta/workspace {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision','updatedAt'])
        && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision','updatedAt'])
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/{group}/{recordId} {
      allow read: if owner(uid) && group in ['classes','assessments','submissions'];
      allow create, update: if owner(uid) && group in ['classes','assessments','submissions'] && validPayload();
      allow delete: if owner(uid) && group in ['classes','assessments','submissions'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
